<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:maplibre="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Fog, traveled roads and the live marker stay on MapLibre's native render surface. -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        maplibre:maplibre_cameraZoomMax="22.0"
        maplibre:maplibre_renderTextureMode="true"
        maplibre:maplibre_pixelRatio="2.0" />

    <TextView
        android:id="@+id/statsText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:maxWidth="210dp"
        android:background="@drawable/panel_background"
        android:elevation="8dp"
        android:text="@string/stats_initial"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp" />

    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:background="@drawable/circle_button_background"
        android:contentDescription="@string/settings"
        android:elevation="8dp"
        android:padding="12dp"
        android:src="@drawable/ic_settings" />

    <ImageButton
        android:id="@+id/centerCarButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="80dp"
        android:background="@drawable/circle_button_background"
        android:contentDescription="@string/center_on_car"
        android:elevation="8dp"
        android:padding="12dp"
        android:src="@drawable/ic_my_location" />

    <LinearLayout
        android:id="@+id/controlPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:background="@drawable/panel_background"
        android:elevation="8dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Not tracking"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/enableButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Enable" />
    </LinearLayout>
</FrameLayout>
