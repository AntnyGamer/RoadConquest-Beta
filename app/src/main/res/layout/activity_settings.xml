<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/rcScreenBg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textColor="?attr/rcTextPrimary"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Map and appearance"
            android:textColor="?attr/rcTextPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/mapStyleButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Map: Streets" />

        <Button
            android:id="@+id/uiThemeButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Appearance: Use phone setting" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose a map style. Tracking reveals visited places, and driving saves blue road lines."
            android:textColor="?attr/rcTextSecondary"
            android:textSize="13sp" />

        <Switch
            android:id="@+id/fogSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Show fog"
            android:textColor="?attr/rcTextPrimary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Hiding fog does not affect tracking or saved progress."
            android:textColor="?attr/rcTextSecondary"
            android:textSize="13sp" />

        <Switch
            android:id="@+id/manualOnlySwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Track only when I press Enable"
            android:textColor="?attr/rcTextPrimary"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="When off, RoadConquest can track automatically in the background. After a force-stop, reopen the app once."
            android:textColor="?attr/rcTextSecondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Background tracking reliability"
            android:textColor="?attr/rcTextPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="For reliable background tracking, allow precise location all the time and unrestricted background battery use."
            android:textColor="?attr/rcTextSecondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/locationSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Location permission" />

        <Button
            android:id="@+id/deviceLocationButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Device location settings" />

        <Button
            android:id="@+id/notificationSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="RoadConquest notifications" />

        <Button
            android:id="@+id/batterySettingsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Battery/background restrictions" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Account and leaderboard privacy"
            android:textColor="?attr/rcTextPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/accountSummaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Not signed in"
            android:textColor="?attr/rcTextSecondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/accountButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Account / sign in" />

        <Switch
            android:id="@+id/leaderboardPrivacySwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="Show me on global leaderboards"
            android:textColor="?attr/rcTextPrimary"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/verifyDrivesSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="Send live driving evidence for verified scores"
            android:textColor="?attr/rcTextPrimary"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/verificationStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Checking verified scoring…"
            android:textColor="?attr/rcTextSecondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/leaderboardsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Global leaderboards" />

        <Button
            android:id="@+id/achievementsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Achievements" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="New accounts are visible on leaderboards and verified-drive sharing is on by default. Verified scoring sends precise live GPS batches and app integrity evidence; saved history is not uploaded. Both settings can be turned off."
            android:textColor="?attr/rcTextSecondary"
            android:textSize="13sp" />

        <Button
            android:id="@+id/exportButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Export my data (.zip)" />

        <TextView
            android:id="@+id/dataSummaryText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="?attr/rcTextSecondary"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Privacy"
            android:textColor="?attr/rcTextPrimary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Drive history and explored places stay on this device. Road matching sends GPS batches to OSRM. Accounts use the account service. Verified scoring, when enabled, sends precise live GPS and app-integrity evidence; saved history and complete routes are not uploaded."
            android:textColor="?attr/rcTextSecondary"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingBottom="20dp"
            android:text="Map: OpenFreeMap © OpenMapTiles, data © OpenStreetMap contributors. Road matching: OSRM."
            android:textColor="?attr/rcTextSecondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/terrainCreditsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Licenses and map credits" />

        <Button
            android:id="@+id/githubButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/github_button" />
    </LinearLayout>
</ScrollView>
